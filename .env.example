# ─── Supabase ──────────────────────────────────────────────────────────────
# Panel de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# ¡SOLO servidor! Nunca la exponga con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Cadena de conexión Postgres: Connect → Connection string → Session pooler.
# Solo la usan `pnpm db:push` y herramientas locales; la app no la necesita (no la ponga en Vercel).
# Si la contraseña tiene caracteres especiales, codifíquelos: @ → %40, / → %2F, # → %23.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ─── Aplicación ────────────────────────────────────────────────────────────
# URL pública. En Vercel puede dejarse vacía: se usa el dominio de producción del proyecto.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp de respaldo del negocio (el real se edita en /admin/ajustes). Solo dígitos, con código de país.
NEXT_PUBLIC_WHATSAPP_NEGOCIO=5355555555

# ─── Modo demo ─────────────────────────────────────────────────────────────
# true: muestra las credenciales en el login y habilita «Restablecer demo».
NEXT_PUBLIC_DEMO_MODE=true
DEMO_ADMIN_EMAIL=admin@demo.cu
DEMO_ADMIN_PASSWORD=demo1234
