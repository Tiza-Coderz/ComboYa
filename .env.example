# ─── Supabase ──────────────────────────────────────────────────────────────
# Panel de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# ¡SOLO servidor! Nunca la exponga con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Cadena de conexión Postgres (Settings → Database → Connection string → URI).
# La usa la CLI de Supabase para aplicar migraciones y el seed.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ─── Aplicación ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp del negocio en formato internacional, sin "+" ni espacios.
NEXT_PUBLIC_WHATSAPP_NEGOCIO=5355555555

# ─── Modo demo ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_DEMO_MODE=true
DEMO_ADMIN_EMAIL=admin@demo.cu
DEMO_ADMIN_PASSWORD=demo1234
